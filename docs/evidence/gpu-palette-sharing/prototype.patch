@@ -0,0 +1,61 @@
+`timescale 1ns/1ps
+module tb_fb_palette_mailbox #(parameter bit VIOLATE=0);
+    reg sys_clk=0,pix_clk=0,sys_reset=1;
+    wire pix_reset=sys_reset;
