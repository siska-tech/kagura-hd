+`timescale 1ns/1ps
+// CSR-to-executor integration: capacity includes the active descriptor.
+module tb_fb_palette_queue;
+    localparam DEPTH=8,REGISTER_HEAD=1;
+    reg clk=0,reset=1;
+    always #(500.0/54.0) clk=~clk;
+    reg req_valid=0,req_write=0;
+    reg [4:0] req_addr=0;
+    reg [7:0] req_wdata=0;
+    wire req_ready,rsp_valid,rsp_error,busy,irq,valid,ready,done,read_result;
+    wire [7:0] rsp_rdata,error;
+    wire [15:0] tag;
+    wire [127:0] command;
+    wire engine_valid,engine_ready;
+    wire [127:0] engine_command;
+    generate if(REGISTER_HEAD) begin: registered_head
+        kagura_fb_command_head head(.clk,.reset,.in_valid(valid),.in_ready(ready),.in_command(command),
+            .out_valid(engine_valid),.out_ready(engine_ready),.out_done(done),.out_command(engine_command));
+    end else begin: direct_head
+        assign engine_valid=valid;assign ready=engine_ready;assign engine_command=command;
+    end endgenerate
+    wire [511:0] upload_data,read_data;
+    wire [191:0] present_palette;
+    wire present_done,present_ready,present_page;
+    reg pix_clk=0,allow_vblank=0;
+    always #(500.0/74.25) pix_clk=~pix_clk;
+    reg [10:0] cx=0;reg [9:0] cy=0;
+    integer phase=0,applications=0,completions=0;
+    reg last_ack=0;
+    always @(negedge pix_clk) begin
+        phase=(phase+1)%11;cx=allow_vblank && phase==0 ? 1649 : 0;cy=allow_vblank && phase==0 ? 719 : 0;
+        #1;
+        if({candidate.palette,candidate.active_page,candidate.generation,candidate.present_ack,candidate.present_seen,candidate.rgb}
+         !=={reference.palette,reference.active_page,reference.generation,reference.present_ack,reference.present_seen,reference.rgb})
+            $fatal(1,"queued shared palette pixel mismatch");
+        if(!reset && candidate.present_ack!=last_ack) applications++;
+        last_ack=candidate.present_ack;
+    end
+    kagura_fb_scanout #(.SHARED_PRESENT_PALETTE(1)) candidate(
+        .sys_clk(clk),.sys_reset(reset),.pix_clk,.pix_reset(reset),.cx,.cy,
+        .present_valid,.present_page,.present_palette,.present_ready,.present_done,
+        .req_ready(1'b0),.rsp_done(1'b0),.rsp_error(1'b0),.scan_word_valid(1'b0),.scan_word_data(32'd0));
+    kagura_fb_scanout_palette_reference reference(
+        .sys_clk(clk),.sys_reset(reset),.pix_clk,.pix_reset(reset),.cx,.cy,
+        .present_valid,.present_page,.present_palette,
+        .req_ready(1'b0),.rsp_done(1'b0),.rsp_error(1'b0),.scan_word_valid(1'b0),.scan_word_data(32'd0));
+    always @(negedge clk) begin
+        #1;
+        if({candidate.present_ready,candidate.present_done,candidate.req_valid,candidate.req_addr}
+         !=={reference.present_ready,reference.present_done,reference.req_valid,reference.req_addr})
+            $fatal(1,"queued shared palette completion edge mismatch");
+    end
+    reg mem_ready=0,mem_done=0;
+    reg [511:0] mem_data=0;
+    wire present_valid,host_valid;
+    kagura_fb_registers #(.QUEUE_DEPTH(DEPTH)) regs(
+        .clk,.reset,.enabled(1'b1),.spi_late(1'b0),.video_error(1'b0),.audio_error(1'b0),.external_error(1'b0),
+        .req_valid,.req_write,.req_addr,.req_wdata,.req_ready,.rsp_valid,.rsp_error,.rsp_rdata,.busy,.irq,
+        .cmd_valid(valid),.cmd_ready(ready),.cmd_done(done),.cmd_read_result(read_result),
+        .cmd_tag(tag),.cmd_error(error),.cmd_read_data(read_data),.command,.upload_data);
+    kagura_fb_commands #(.REGISTER_DECODE(REGISTER_HEAD)) engine(
+        .clk,.reset,.valid(engine_valid),.ready(engine_ready),.command(engine_command),.upload_data,.done,.error,.tag,.read_data,.read_result,
+        .host_valid,.host_ready(mem_ready),.host_done(mem_done),.host_error(1'b0),.host_rdata(mem_data),
+        .host_write(),.host_addr(),.host_words(),.host_wdata(),.host_mask(),
+        .present_valid,.present_ready,.present_done,.present_page,.present_palette,
+        .audio_capture(),.audio_apply(),.audio_commit_done(),
+        .audio_settings_valid(1'b0),.audio_busy(1'b0),.audio_settle(1'b0),.audio_ready(1'b0),.audio_done(1'b0),.audio_apply_error(1'b0));
+    task access(input bit wr,input integer addr,data,input bit fails,output reg [7:0] result);
+        @(negedge clk);req_valid=1;req_write=wr;req_addr=5'(addr);req_wdata=8'(data);
+        do @(posedge clk);while(!req_ready);
+        @(negedge clk);req_valid=0;
+        while(!rsp_valid) @(negedge clk);
+        if(rsp_error!==fails) $fatal(1,"CSR addr=%0d error=%0d expected=%0d",addr,rsp_error,fails);
+        result=rsp_rdata;
+    endtask
+    reg [7:0] value;
+
+    task submit(input integer opcode,arg,color,id);
+        access(1,8,opcode,0,value); access(1,9,arg,0,value);
+        access(1,10,id&255,0,value); access(1,11,id>>8,0,value);
+        access(1,12,color&255,0,value); access(1,13,color>>8,0,value);
+        access(1,26,1,0,value);
+    endtask
+    task finish_command(input integer id,err);
+        wait(irq);
+        access(0,28,0,0,value);if(value!==8'(id)) $fatal(1,"tag low order");
+        access(0,29,0,0,value);if(value!==8'(id>>8)) $fatal(1,"tag high order");
+        access(0,30,0,0,value);if(value!==8'(err)) $fatal(1,"completion error");
+        repeat($urandom_range(20,80)) @(negedge clk);
+        access(0,28,0,0,value);if(value!==8'(id)) $fatal(1,"tag overwritten before ACK");
+        access(0,7,0,0,value);if(value!==8'(err)) $fatal(1,"sticky error not reported");
+        access(1,31,1,0,value);if(err) access(1,7,0,0,value);
+        completions++;
+    endtask
+    initial begin
+        repeat(4) @(negedge clk);reset=0;
+        for(integer round_id=0;round_id<16;round_id++) begin
+            allow_vblank=0;
+            submit(3,0,0,round_id*8);wait(candidate.present_pending);
+            submit(2,6,12'hf20,round_id*8+1);
+            submit(3,1,0,round_id*8+2);
+            submit(2,16,12'hab0,round_id*8+3); // invalid index, error must survive
+            submit(3,0,0,round_id*8+4);
+            submit(2,15,12'h05a,round_id*8+5);
+            submit(3,1,0,round_id*8+6);
+            submit(0,0,0,round_id*8+7);
+            if(!busy || regs.queue_count!=8) $fatal(1,"queue8 not full");
+            repeat(20) @(negedge clk);
+            if(irq || done || present_done) $fatal(1,"early PRESENT completion");
+            allow_vblank=1;
+            for(integer n=0;n<8;n++) finish_command(round_id*8+n,n==3 ? 2 : 0);
+            repeat(8) @(negedge clk);
+            if(regs.queue_count!=0 || busy) $fatal(1,"queue8 did not drain");
+            if(present_palette[72+:12]!==12'hf20 || present_palette[180+:12]!==12'h05a) $fatal(1,"palette lost");
+        end
+        // Reset aborts an in-flight PRESENT plus younger PALETTE/PRESENT.
+        for(integer n=0;n<16;n++) begin
+            allow_vblank=0;submit(3,0,0,200);wait(candidate.present_pending);
+            submit(2,n,12'h123,201);submit(3,1,0,202);
+            repeat($urandom_range(1,9)) @(negedge clk);reset=1;
+            repeat(4) @(negedge clk);reset=0;allow_vblank=1;
+            repeat(16) @(negedge clk);
+            if(irq || regs.queue_count!=0 || candidate.present_pending) $fatal(1,"reset flush mismatch");
+            submit(3,0,0,203);finish_command(203,0);
+        end
+        if(applications<64 || completions!=144) $fatal(1,"insufficient coverage");
+        $display("PASS: shared PALETTE queue8 ordering, full queue, delayed ACK, sticky error, reset; completions=%0d applications=%0d",completions,applications);
+        $finish;
+    end
+    initial begin #5000000;$fatal(1,"palette queue watchdog");end
+endmodule
