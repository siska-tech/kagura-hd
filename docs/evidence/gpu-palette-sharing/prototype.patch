@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+mkdir -p build/fb-palette-sharing
+exec 9>build/fb-palette-sharing/.lock
+flock -n 9 || { echo 'Palette sharing regression already running' >&2; exit 1; }
+for top in tb_fb_palette_mailbox tb_fb_palette_queue; do
+    dir="build/fb-palette-sharing/$top"
+    mkdir -p "$dir"
+    verilator --binary --timing --timescale 1ns/1ps -Wno-fatal --top-module "$top" \
+        --Mdir "$PWD/$dir" -j 4 rtl/fb/kagura_fb_scanout.sv rtl/fb/kagura_fb_line_fetch.sv \
+        rtl/fb/kagura_fb_line_banks.sv rtl/memory/kagura_ram_tdp.sv \
+        rtl/fb/kagura_fb_registers.sv rtl/fb/kagura_fb_upload_word.sv \
+        rtl/fb/kagura_fb_command_head.sv rtl/fb/kagura_fb_commands.sv rtl/fb/kagura_fb_fill_burst.sv \
+        sim/support/kagura_fb_scanout_palette_reference.sv "sim/tests/$top.sv" >"$dir/build.log" 2>&1
+    for seed in 1 19 73; do
+        timeout 60 "$dir/V$top" +verilator+seed+"$seed" | tee "$dir/seed-$seed.log"
+        grep -q 'PASS: shared PALETTE' "$dir/seed-$seed.log"
+    done
+done
+dir=build/fb-palette-sharing/full-scanout
+mkdir -p "$dir"
+verilator --binary --timing --timescale 1ns/1ps -Wno-fatal --top-module tb_fb_scanout \
+    -GSHARED_PRESENT_PALETTE=1 --Mdir "$PWD/$dir" -j 4 \
+    rtl/fb/kagura_fb_scanout.sv rtl/fb/kagura_fb_line_banks.sv rtl/fb/kagura_fb_line_fetch.sv \
+    rtl/fb/kagura_fb_arbiter.sv rtl/fb/kagura_fb_burst_ctrl.sv rtl/memory/kagura_ram_tdp.sv \
+    sim/support/kagura_hyperram_pair_model.sv sim/tests/tb_fb_scanout.sv >"$dir/build.log" 2>&1
+timeout 60 "$dir/Vtb_fb_scanout" | tee "$dir/run.log"
+grep -q 'PASS: fb_scanout' "$dir/run.log"
+# Prove that the optional sharing mode rejects a producer contract violation.
+dir=build/fb-palette-sharing/contract-negative
+mkdir -p "$dir"
+verilator --binary --timing --timescale 1ns/1ps -Wno-fatal --top-module tb_fb_palette_mailbox \
+    -GVIOLATE=1 --Mdir "$PWD/$dir" -j 4 rtl/fb/kagura_fb_scanout.sv \
+    rtl/fb/kagura_fb_line_fetch.sv rtl/fb/kagura_fb_line_banks.sv rtl/memory/kagura_ram_tdp.sv \
+    sim/support/kagura_fb_scanout_palette_reference.sv sim/tests/tb_fb_palette_mailbox.sv >"$dir/build.log" 2>&1
+ulimit -c 0
+if timeout 60 "$dir/Vtb_fb_palette_mailbox" >"$dir/run.log" 2>&1; then
+    echo 'Expected a stability assertion failure' >&2; exit 1
+fi
+grep -q 'shared PRESENT palette changed before acknowledgement' "$dir/run.log"
+echo 'PASS: shared PALETTE stability contract rejects an invalid producer'
