+        .req_ready,.rsp_done,.rsp_error,.scan_word_valid,.scan_word_data);
+    integer phase=0,updates=0,acks=0;
+    reg ack_previous=0;
+    always @(negedge pix_clk) begin
+        // Short vblank periods deliberately sweep request/synchronizer phase.
+        phase=(phase+1)%11;cx=phase==0 ? 1649 : 0;cy=phase==0 ? 719 : 0;
+        #1;
+        if({candidate.palette,candidate.active_page,candidate.generation,candidate.line_page,
+            candidate.line_row,candidate.line_generation,candidate.present_ack,candidate.present_seen}
+           !=={reference.palette,reference.active_page,reference.generation,reference.line_page,
+            reference.line_row,reference.line_generation,reference.present_ack,reference.present_seen})
+            $fatal(1,"PRESENT mailbox pixel application edge/data mismatch");
+        if(!pix_reset && reference.present_ack!=ack_previous) updates++;
+        ack_previous=reference.present_ack;
+    end
+    always @(negedge sys_clk) begin
+        #1;
+        if({candidate.present_ready,candidate.present_done,candidate.req_valid,candidate.req_addr}
+           !=={present_ready,present_done,req_valid,req_addr})
+            $fatal(1,"PRESENT mailbox host handshake mismatch");
+        if(present_done) acks++;
+    end
+    initial begin
+        repeat(4) @(negedge sys_clk);sys_reset=0;
+        for(integer trial=0;trial<512;trial++) begin
+            wait(present_ready);
+            repeat($urandom_range(1,6)) @(negedge sys_clk);
+            present_page=1'($urandom);
+            for(integer n=0;n<6;n++) present_palette[n*32+:32]=$urandom;
+            present_valid=1;
+            @(negedge sys_clk);present_valid=0;
+            if(VIOLATE) begin present_palette=~present_palette; repeat(4) @(negedge sys_clk); $fatal(1,"missing stability rejection"); end
+            if(trial%31==0) begin
+                // Abort in-flight mailboxes, assert both domain resets together.
+                repeat(2) @(negedge sys_clk);sys_reset=1;
+                repeat(3) @(negedge sys_clk);sys_reset=0;
+            end else wait(present_done);
+        end
+        repeat(2) @(negedge sys_clk);
+        if(acks<450 || updates<450) $fatal(1,"insufficient mailbox coverage");
+        $display("PASS: shared PALETTE mailbox frozen-reference cycle equality; acknowledgements=%0d applications=%0d resets=17",acks,updates);
+        $finish;
+    end
+    initial begin #2000000;$fatal(1,"mailbox watchdog");end
+endmodule
